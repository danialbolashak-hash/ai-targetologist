{
  "crons": [
    {
      "path": "/api/cron/monitor",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/optimize",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/scale",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" }
      ]
    }
  ]
}
