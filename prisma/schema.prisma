generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  supabaseId    String    @unique
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  stripeId      String?
  trialEndsAt   DateTime?
  isBanned      Boolean   @default(false)
  lastLoginAt   DateTime?
  // Notification channels for the AI assistant
  phone           String?
  telegramChatId  String?
  notifyTelegram  Boolean @default(true)
  notifySms       Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  businessProfiles    BusinessProfile[]
  facebookAccounts    FacebookAccount[]
  subscription        Subscription?
  auditLogs           AuditLog[]
  notifications       Notification[]
}

enum NotificationType {
  INFO
  WARNING
  CRITICAL
  CREATIVE_READY
  OFFER_READY
  OPTIMIZATION
}

// AI assistant messages / alerts shown in-app and sent to channels
model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(INFO)
  title      String
  body       String
  campaignId String?
  // Generated content the AI proposes (new creative / offer), as JSON
  payload    Json?
  actionUrl  String?
  isRead     Boolean          @default(false)
  sentTg     Boolean          @default(false)
  sentSms    Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

// Security audit trail — who did what
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── BUSINESS ─────────────────────────────────────────────────────────────────

model BusinessProfile {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  niche           String
  product         String
  price           Float
  avgCheck        Float
  budget          Float
  location        String
  country         String
  competitors     String[]
  goals           String[]
  painPoints      String[]
  customerType    String
  aiAnalysis      Json?
  strategy        Json?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaigns       Campaign[]
  audiences       Audience[]
  offers          Offer[]
  leads           Lead[]
}

// ─── FACEBOOK ─────────────────────────────────────────────────────────────────

model FacebookAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fbUserId          String    @unique
  name              String
  email             String?
  accessToken       String    // encrypted
  tokenExpiresAt    DateTime?
  isConnected       Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  adAccounts        AdAccount[]
}

model AdAccount {
  id                String          @id @default(cuid())
  facebookAccountId String
  facebookAccount   FacebookAccount @relation(fields: [facebookAccountId], references: [id], onDelete: Cascade)
  fbAdAccountId     String          @unique  // act_XXXXXXXX
  name              String
  currency          String          @default("USD")
  timezone          String          @default("UTC")
  businessId        String?
  pixelId           String?
  pageId            String?
  pageAccessToken   String?
  instagramId       String?
  status            AdAccountStatus @default(ACTIVE)
  permissions       String[]
  spendLimit        Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  campaigns         Campaign[]
}

// ─── CAMPAIGNS ────────────────────────────────────────────────────────────────

model Campaign {
  id                String          @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adAccountId       String
  adAccount         AdAccount       @relation(fields: [adAccountId], references: [id])
  fbCampaignId      String?
  name              String
  objective         CampaignObjective
  dailyBudget       Float
  lifetimeBudget    Float?
  status            CampaignStatus  @default(DRAFT)
  approvedAt        DateTime?
  launchedAt        DateTime?
  startDate         DateTime?
  endDate           DateTime?
  targetROAS        Float           @default(3.0)
  targetCPL         Float?
  targetCPA         Float?
  aiManaged         Boolean         @default(true)
  optimizationCount Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  adSets            AdSet[]
  analytics         Analytics[]
  optimizationLogs  OptimizationLog[]
  aiRecommendations AiRecommendation[]
}

model AdSet {
  id                String      @id @default(cuid())
  campaignId        String
  campaign          Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audienceId        String?
  audience          Audience?   @relation(fields: [audienceId], references: [id])
  fbAdSetId         String?
  name              String
  dailyBudget       Float
  billingEvent      String      @default("IMPRESSIONS")
  optimizationGoal  String      @default("LEAD_GENERATION")
  status            AdSetStatus @default(ACTIVE)
  isWinner          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  ads               Ad[]
}

model Ad {
  id            String    @id @default(cuid())
  adSetId       String
  adSet         AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creativeId    String?
  creative      Creative? @relation(fields: [creativeId], references: [id])
  fbAdId        String?
  name          String
  status        AdStatus  @default(ACTIVE)
  isWinner      Boolean   @default(false)
  score         Float?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Creative {
  id              String        @id @default(cuid())
  businessId      String?
  fbCreativeId    String?
  type            CreativeType
  headline        String
  primaryText     String
  description     String?
  cta             String
  imageUrl        String?
  videoUrl        String?
  linkUrl         String?
  platform        String        @default("META")
  score           Float?
  isWinner        Boolean       @default(false)
  impressions     Int           @default(0)
  clicks          Int           @default(0)
  ctr             Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ads             Ad[]
}

// ─── AUDIENCES ────────────────────────────────────────────────────────────────

model Audience {
  id              String        @id @default(cuid())
  businessId      String
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fbAudienceId    String?
  name            String
  type            AudienceType
  ageMin          Int           @default(18)
  ageMax          Int           @default(65)
  gender          String        @default("ALL")
  locations       Json          // [{country, city, radius}]
  interests       Json          @default("[]")
  behaviors       Json          @default("[]")
  excludedIds     String[]
  lookalikeSeed   String?
  lookalikePct    Float?
  estimatedSize   Int?
  aiExplanation   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  adSets          AdSet[]
}

// ─── OFFERS ───────────────────────────────────────────────────────────────────

model Offer {
  id                String    @id @default(cuid())
  businessId        String
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  headline          String
  subheadline       String?
  usp               String
  hook              String
  body              String
  cta               String
  painPoints        String[]
  emotionalTriggers String[]
  urgencyTriggers   String[]
  scarcityTriggers  String[]
  isActive          Boolean   @default(true)
  score             Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── ANALYTICS ────────────────────────────────────────────────────────────────

model Analytics {
  id              String    @id @default(cuid())
  campaignId      String
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adSetId         String?
  adId            String?
  date            DateTime
  spend           Float     @default(0)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  reach           Int       @default(0)
  leads           Int       @default(0)
  purchases       Int       @default(0)
  revenue         Float     @default(0)
  cpm             Float?
  ctr             Float?
  cpc             Float?
  cpl             Float?
  cpa             Float?
  roas            Float?
  frequency       Float?
  conversionRate  Float?
  fetchedAt       DateTime  @default(now())

  @@index([campaignId, date])
}

// ─── OPTIMIZATION ─────────────────────────────────────────────────────────────

model OptimizationLog {
  id              String            @id @default(cuid())
  campaignId      String
  campaign        Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type            OptimizationType
  trigger         String
  action          String
  before          Json
  after           Json
  result          String?
  appliedAt       DateTime          @default(now())
}

model AiRecommendation {
  id              String              @id @default(cuid())
  campaignId      String
  campaign        Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type            RecommendationType
  priority        Priority
  title           String
  description     String
  suggestedAction String
  isApplied       Boolean             @default(false)
  isAuto          Boolean             @default(false)
  appliedAt       DateTime?
  createdAt       DateTime            @default(now())
}

// ─── LEADS & SALES ────────────────────────────────────────────────────────────

model Lead {
  id              String      @id @default(cuid())
  businessId      String
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fbLeadId        String?
  name            String?
  email           String?
  phone           String?
  source          String?
  adId            String?
  campaignId      String?
  status          LeadStatus  @default(NEW)
  value           Float?
  notes           String?
  crmSentAt       DateTime?
  convertedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ─── SUBSCRIPTIONS ────────────────────────────────────────────────────────────

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan
  stripeSubId       String?   @unique
  stripePriceId     String?
  status            SubStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum AdAccountStatus {
  ACTIVE
  DISABLED
  UNSETTLED
}

enum CampaignObjective {
  OUTCOME_LEADS
  OUTCOME_SALES
  OUTCOME_TRAFFIC
  OUTCOME_AWARENESS
  OUTCOME_ENGAGEMENT
  OUTCOME_APP_PROMOTION
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  ERROR
  DELETED
}

enum AdSetStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum AdStatus {
  ACTIVE
  PAUSED
  DELETED
  DISAPPROVED
}

enum CreativeType {
  IMAGE
  VIDEO
  CAROUSEL
  STORY
  REEL
}

enum AudienceType {
  COLD
  WARM
  RETARGETING
  LOOKALIKE
  CUSTOM
}

enum OptimizationType {
  PAUSE_AD
  PAUSE_ADSET
  INCREASE_BUDGET
  DECREASE_BUDGET
  NEW_CREATIVE
  NEW_AUDIENCE
  NEW_OFFER
  DUPLICATE_WINNER
  SCALE_UP
  EMERGENCY_STOP
}

enum RecommendationType {
  CREATIVE
  AUDIENCE
  BUDGET
  OFFER
  SCALING
  EMERGENCY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}
