# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL="your_postgresql_connection_string"

# ─── SUPABASE ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ─── AI ──────────────────────────────────────────────────────
OPENAI_API_KEY="your_openai_api_key"

# ─── META / FACEBOOK ─────────────────────────────────────────
META_APP_ID="1234567890"
META_APP_SECRET="your_app_secret"
META_REDIRECT_URI="https://yourapp.vercel.app/api/facebook/callback"
META_SYSTEM_TOKEN="EAAxxxxx"  # System User token for server-side calls

# ─── STRIPE ──────────────────────────────────────────────────
STRIPE_SECRET_KEY="your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_AGENCY_PRICE_ID="price_..."

# ─── APP ─────────────────────────────────────────────────────
NEXTAUTH_URL="https://yourapp.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-random-secret"

# ─── AI ASSISTANT NOTIFICATIONS ──────────────────────────────
# Telegram (free): create a bot via @BotFather, paste its token here
TELEGRAM_BOT_TOKEN="7xxx:xxx"
# SMS via Twilio (optional, paid)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─── CRM INTEGRATIONS (optional) ─────────────────────────────
WHATSAPP_API_KEY="EAAxxxxx"
